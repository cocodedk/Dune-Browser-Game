# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# GitHub Pages staging directory assembled by deploy-pages.yml
.pages-site/

# Secrets — .env.example IS committed, .env is NOT
.env
.env.local
.env.*.local

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/
.playwright-mcp/

# Screenshots captured during development
*.png
!public/**/*.png
!docs/**/*.png

# Agent tooling. Per-machine settings stay local; shared skills are committed,
# so project knowledge travels with the repository instead of living in one
# developer's home directory. Git cannot re-include a path inside an ignored
# directory, so this ignores .claude's *contents* rather than the folder.
.claude/*
!.claude/skills/
.codex/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Visual-review screenshots (scripts/shoot.mjs)
.shots/
