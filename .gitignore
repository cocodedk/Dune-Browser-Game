# Dependencies
node_modules

# Build output
dist/
*.tsbuildinfo

# GitHub Pages staging directory assembled by deploy-pages.yml
.pages-site/

# Secrets — .env.example IS committed, .env is NOT
.env
.env.local
.env.*.local

# Test artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/
.playwright-mcp/

# Screenshots captured during development
*.png
!public/**/*.png
!docs/**/*.png

# Agent tooling. Per-machine settings stay local; shared skills are committed,
# so project knowledge travels with the repository instead of living in one
# developer's home directory. Git cannot re-include a path inside an ignored
# directory, so this ignores .claude's *contents* rather than the folder.
.claude/*
!.claude/skills/
.codex/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Visual-review screenshots (scripts/shoot.mjs)
.shots/

# Licensed asset feedstock (threejsassets.com) — the license forbids
# redistributing raw GLB/component files, and this repo is PUBLIC. Only
# reshaped, baked derivatives that ship in the game may be committed.
landscape-shop/*/feedstock/
landscape-shop/feedstock-packs/

# WP04 chunk W4d published seed sweep: raw per-run JSON is regenerable
# (progress.md Round 16 — "summaries committed, raw traces regenerable").
# Only seeds.txt and sweep-report.md, both siblings of this dir, are committed.
docs/PRD/game-completion/baseline/wp04-sweep/raw/
