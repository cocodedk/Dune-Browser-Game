{
  "name": "dune-browser-game",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "playwright test",
    "test:unit": "vitest run",
    "shop:check": "node scripts/check-shops.mjs",
    "shop:new": "node scripts/new-shop.mjs",
    "shop:thopter": "vite vehicle-shop/ornihopter",
    "shop:thopter:build": "vite build vehicle-shop/ornihopter",
    "shop:thopter:check": "tsc -p vehicle-shop/ornihopter --noEmit",
    "shop:thopter:shoot": "node vehicle-shop/ornihopter/tools/shoot.mjs",
    "shop:harvester": "vite vehicle-shop/harvester",
    "shop:harvester:build": "vite build vehicle-shop/harvester",
    "shop:harvester:check": "tsc -p vehicle-shop/harvester --noEmit",
    "shop:harvester:shoot": "node vehicle-shop/harvester/tools/shoot.mjs",
    "cast:new": "node scripts/new-shop.mjs --root character-shop",
    "cast:chani": "vite character-shop/chani",
    "cast:chani:build": "vite build character-shop/chani",
    "cast:chani:check": "tsc -p character-shop/chani --noEmit",
    "cast:stilgar": "vite character-shop/stilgar",
    "cast:stilgar:build": "vite build character-shop/stilgar",
    "cast:stilgar:check": "tsc -p character-shop/stilgar --noEmit",
    "cast:duncan": "vite character-shop/duncan",
    "cast:duncan:build": "vite build character-shop/duncan",
    "cast:duncan:check": "tsc -p character-shop/duncan --noEmit",
    "land:new": "node scripts/new-shop.mjs --root landscape-shop"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
